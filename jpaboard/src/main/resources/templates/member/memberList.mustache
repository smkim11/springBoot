<!DOCTYPE html>
<html>
<head>
 <!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
<style>
	body{
	text-align:center
	}
	table{
	margin:auto;
	}
</style>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
{{>layouts/header}}
	<h1>회원 목록</h1>
	<div>
		{{loginMember.memberId}}님 반갑습니다.
		<a href="/member/logout">로그아웃</a>
		<a href="/member/modifyPw">비밀번호수정</a>
		<a href="/member/removeMember">회원탈퇴</a>
	</div>
	
	<!-- pw를 제외한 멤버 목록 출력 -->
	<table class="w-50 table table-bordered">
		<tr>
			<th>NO</th>
			<th>ID</th>
		</tr>
		{{#list}}
			<tr>
				<td>{{memberNo}}</td>
				<td>{{memberId}}</td>
			</tr>
		{{/list}}
	</table>
	<form action = "/member/memberList">
		<input type="text" name ="word">
		<button class="btn btn-secondary">검색</button>
	</form>
	{{^first}}
	<a href="/member/memberList?currentPage={{prePage}}">이전</a>
	{{/first}}
	{{nextPage}}/{{lastPage}}
	{{#hasNext}}
	<a href="/member/memberList?currentPage={{nextPage}}">다음</a>
	{{/hasNext}}
{{>layouts/footer}}
</body>
</html>