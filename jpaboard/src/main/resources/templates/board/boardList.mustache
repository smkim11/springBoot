<!DOCTYPE html>
<html>
<head>
 <!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
<style>
	body{
	text-align:center
	}
	table{
	margin:auto;
	}
</style>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
{{>layouts/header}}
	<h1>리스트</h1>
	<a href="/board/addBoard">추가</a>
	<table class="w-75 table table-bordered">
		<tr>
			<th>번호</th>
			<th>제목</th>
			<th>내용</th>
		</tr>
			{{#list}}
				<tr>
					<td>{{boardNo}}</td>
					<td><a href="/board/boardOne?boardNo={{boardNo}}">{{boardTitle}}</a></td>
					<td>{{boardContent}}</td>
				</tr>
			{{/list}}
	</table>
	<div>
		{{^first}}
		<a href="/board/boardList?currentPage={{prePage}}">이전</a>
		{{/first}}
		{{nextPage}}/{{lastPage}}
		{{#hasNext}}
		<a href="/board/boardList?currentPage={{nextPage}}">다음</a>
		{{/hasNext}}
	</div>
	<form action="/board/boardList">
		<input type="text" name="word">
		<button type="submit" class="btn btn-secondary">검색</button>
	</form>
{{>layouts/footer}}
</body>
</html>