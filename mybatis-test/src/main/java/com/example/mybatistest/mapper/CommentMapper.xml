<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mybatistest.mapper.CommentMapper">
	<delete id="deleteByBoardNo" parameterType="int"><!--mybatis는 update, delete, insert는 자동으로 Integer반환-->
		delete from comment
		where board_no= #{boardNo}
	</delete>
</mapper>