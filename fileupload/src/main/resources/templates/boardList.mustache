<!DOCTYPE html>
<html>
<head>
<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
<style>
	body{
	text-align:center
	}
	table{
	margin:auto;
	}
</style>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<h1>BOARD LIST</h1>
	<a href="/addBoard">추가</a>
	<table class="w-50 table table-bordered">
		<tr>
			<th>NO</th>
			<th>TITLE</th>
		</tr>
		{{#list}}
			<tr>
				<th>{{bno}}</th>
				<th><a href="/boardOne?bno={{bno}}">{{title}}</a></th>
			</tr>
		{{/list}}
	</table>
	{{^isFirst}}
		<a href="/?currentPage={{prePage}}">이전</a>
	{{/isFirst}}
	{{nextPage}}/{{lastPage}}
	{{#hasNext}}
		<a href="/?currentPage={{nextPage}}">다음</a>
	{{/hasNext}}
	<form action="/">
		<input type="text" name="word">
		<button>검색</button>
	</form>
</body>
</html>