<!DOCTYPE html>
<html>
<head>
 <!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
<style>
	body{
	text-align:center
	}
	table{
	margin:auto;
	}
</style>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
{{>layouts/header}}
	<h1>수정</h1>
	{{#list}}
	<form method="post" action="/board/modifyBoard">
		<table class="w-50 table table-bordered">
			<tr>
				<th>번호</th>
				<td><input type="number" name="boardNo" value="{{boardNo}}" readonly></td>
			</tr>
			<tr>
				<th>제목</th>
				<td><input type="text" name="boardTitle" value="{{boardTitle}}"></td>
			</tr>
			<tr>
				<th>내용</th>
				<td><textarea name ="boardContent">{{boardContent}}</textarea></td>
			</tr>
		</table>
		<button type="submit" class="btn btn-secondary">수정</button>
	</form>
	{{/list}}
{{>layouts/footer}}
</body>
</html>