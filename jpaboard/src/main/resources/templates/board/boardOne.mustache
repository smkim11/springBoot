<!DOCTYPE html>
<html>
<head>
 <!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
<style>
	body{
	text-align:center
	}
	table{
	margin:auto;
	}
</style>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
{{>layouts/header}}
	<h1>상세보기</h1>
	<a href="/board/boardList">목록</a>
	<a href="/board/modifyBoard?boardNo={{boardNo}}">수정</a>
	<a href="/board/deleteBoard?boardNo={{boardNo}}">삭제</a>
	<table class="w-50 table table-bordered">
	{{#list}}
		<tr>
			<th>번호</th>
			<td>{{boardNo}}</td>
		</tr>
		<tr>
			<th>제목</th>
			<td>{{boardTitle}}</td>
		</tr>
		<tr>
			<th>내용</th>
			<td>{{boardContent}}</td>
		</tr>
	{{/list}}
	</table>
{{>layouts/footer}}
</body>
</html>