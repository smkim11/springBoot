<!DOCTYPE html>
<html>
<head>
 <!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	{{>layouts/header}}
	
	{{#msg}}
		<div>{{msg}}</div>
	{{/msg}}
	<a href="/articles/new">New Article</a>
	<table class="table">
	    <thead>
	    <tr>
	        <th scope="col">Id</th>
	        <th scope="col">Title</th>
	        <th scope="col">Content</th>
	    </tr>
	    </thead>
	    <tbody>
	    {{#list}}  <!-- mustache에서 for문  -->
	        <tr>
	            <th>{{id}}</th>
	            <td><a href="/articles/show?id={{id}}">{{title}}</a></td>
	            <td>{{content}}</td>
	        </tr>
	    {{/list}}
	    </tbody>
	</table>
	
	<div>
	<!-- 첫페이지가 아닐때 -->
	{{^list.isFirst}}
		<a href="/articles/index?currentPage={{prePage}}&word={{word}}">이전</a>
	{{/list.isFirst}}
		{{list.getNumber}}/{{list.getTotalPages}}
	<!-- 다음페이지가 있을때 -->
	{{#list.hasNext}}
		<a href="/articles/index?currentPage={{nextPage}}&word={{word}}">다음</a>
	{{/list.hasNext}}
	</div>
	
	<form method="get" action="/articles/index">
		<input type="text" name="word">
		<button type="submit">검색</button>
	</form>
	{{>layouts/footer}}
</body>
</html>